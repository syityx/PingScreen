{
  "name": "pingscreen",
  "productName": "pingscreen",
  "version": "0.1.5",
  "private": true,
  "description": "Point at your screen, choose an intent, and ask AI",
  "author": "pingscreen contributors",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:brand": "node scripts/build-brand.cjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "npm run build && electron . --smoke",
    "build:helper": "node native/hook-helper/run.mjs build",
    "test:helper": "node native/hook-helper/run.mjs test",
    "dist": "npm run build:helper && npm run build && electron-builder --win --publish never",
    "demo": "npm run build:helper && npm run build && electron-builder --config electron-builder.demo.cjs --win --publish never",
    "verify:release": "node scripts/verify-release.cjs"
  },
  "build": {
    "appId": "com.pingscreen.app",
    "productName": "pingscreen",
    "extraMetadata": {
      "demo": false
    },
    "extraFiles": [
      {
        "from": "docs/release-readme.txt",
        "to": "使用说明.txt"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png",
      "build/tray.png",
      "LICENSE",
      "THIRD_PARTY_LICENSES.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper.exe",
          "to": "hook-helper.exe"
        },
        {
          "from": "native/hook-helper/build/capture-helper.exe",
          "to": "capture-helper.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "pingscreen-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "7zip-bin": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
